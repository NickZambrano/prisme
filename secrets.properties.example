# Copier ce fichier en secrets.properties (jamais publié : voir .gitignore) puis le remplir.

# Clé TMDB (recommandations, tendances, affiches) : https://www.themoviedb.org/settings/api
tmdb.apiKey=

# Synchro Google Drive : identifiant OAuth de type « TV et périphériques à saisie limitée » (Google Cloud).
google.clientId=
google.clientSecret=

# Mise à jour automatique : dépôt GitHub public dont les publications contiennent Prisme.apk + prisme-public.json.
update.repo=

# Ancienne version « personnelle » (./build-apk.sh -Ppersonal) : abonnement IPTV intégré. Ne JAMAIS la publier.
fluxfr.server=
fluxfr.user=
fluxfr.pass=
